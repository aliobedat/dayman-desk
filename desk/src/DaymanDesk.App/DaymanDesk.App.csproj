<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>dayman.ico</ApplicationIcon>
    <!-- WO-89: the Windows SDK projection for Windows.Media.Ocr (built into Windows 10/11, no NuGet package). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DaymanDesk</AssemblyName>
    <RootNamespace>DaymanDesk.App</RootNamespace>
    <Version>1.2.2</Version>
    <Product>دايماً ديسك</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Uncompressed single file: the watchdog starts every minute, so no decompression on each start. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaymanDesk.Core\DaymanDesk.Core.csproj" />
  </ItemGroup>

</Project>
